
# ==========================================
# NexusGate Configuration
# ==========================================

# Gateway
SERVER_PORT=8080

# Redis
REDIS_HOST=nexusgate-redis
REDIS_PORT=6379

# JWT Authentication
# Replace this with a securely generated secret.
JWT_SECRET=replace_with_a_secure_random_secret


# ==========================================
# Monitoring Configuration
# ==========================================

# Prometheus
PROMETHEUS_PORT=9090

# Grafana
GRAFANA_PORT=3000
