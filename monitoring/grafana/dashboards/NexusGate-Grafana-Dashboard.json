            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "1000 *\r\nsum by (service) (\r\n  rate(nexusgate_response_time_seconds_sum[5m])\r\n)\r\n/\r\nsum by (service) (\r\n  rate(nexusgate_response_time_seconds_count[5m])\r\n)",
          "legendFormat": "{{service}}",
          "range": false,
          "format": "table",
          "instant": true,
